# CloudGuard Pre-Storage DLP Gateway Configuration
SECURITY_MODE=remediated

# JWT Auth Settings
JWT_SECRET_KEY=replace-with-strong-32-byte-random-secret
JWT_EXPIRE_MINUTES=30

# MongoDB Atlas (Leave empty for automatic local persistent store fallback)
MONGODB_URI=
MONGODB_DB_NAME=dlp_gateway

# AWS S3 Dual-Bucket Configuration (Leave keys empty for local S3 bucket emulator)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_SAFE_BUCKET=cloudguard-dlp-safe-bucket
AWS_QUARANTINE_BUCKET=cloudguard-dlp-quarantine-bucket

# CORS Origins
CORS_ORIGINS=*
